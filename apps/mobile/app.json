{
  "expo": {
    "name": "What Should We Watch",
    "slug": "what-should-we-watch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "wsww",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.manali.wsww",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.manali.wsww",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@clerk/expo",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock What Should We Watch."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8bfc4c94-aad8-4898-b027-a7a0e16259d4"
      }
    },
    "owner": "ayush1220"
  }
}

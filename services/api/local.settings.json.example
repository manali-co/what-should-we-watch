{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "WSWW_ENV": "dev",
    "WSWW_COSMOS_ENDPOINT": "https://<account>.documents.azure.com:443/",
    "WSWW_COSMOS_DATABASE": "wsww",

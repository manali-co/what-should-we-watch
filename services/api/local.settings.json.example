    "WSWW_SIGNING_KEY_NAME": "wsww-api-signing",
    "WSWW_APPLE_BUNDLE_IDS": "[\"app.manali.wsww\"]",
    "WSWW_GOOGLE_CLIENT_IDS": "[\"<google-client-id>\"]"
  }
}
